{
  "expo": {
    "name": "Type 1A",
    "slug": "type1a",
    "scheme": "type1a",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.type1a.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cl.type1a.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Type 1A usa la cámara solo para estimar alimentos. Puedes registrar carbohidratos manualmente."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-file-system",
      "expo-background-task",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Type 1A usa el micrófono para que puedas dictar en vez de escribir. Si este teléfono no sabe pasar voz a texto por su cuenta, lo hace el servicio de dictado de Android y te lo avisa antes.",
          "speechRecognitionPermission": "Type 1A convierte tu voz en texto para que lo revises y lo corrijas. Nada se guarda hasta que tú lo apruebes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "05df8f63-7a23-40b1-96b8-4d40b33d3360"
      }
    },
    "owner": "cris-devit"
  }
}
