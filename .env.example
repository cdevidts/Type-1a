# Backend
HOST=0.0.0.0
PORT=4100
NODE_ENV=development

# Abacus.AI RouteLLM. Keep this only on the backend.
ABACUS_ROUTE_LLM_API_KEY=
ABACUS_ROUTE_LLM_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_ROUTE_LLM_MODEL=route-llm

# CGM: mock | junction | librelinkup
CGM_PROVIDER=mock
CGM_STALE_AFTER_MINUTES=15

# Junction EU is required for a Chile LibreView connection.
JUNCTION_API_KEY=
JUNCTION_USER_ID=
JUNCTION_ENVIRONMENT=sandbox_eu
JUNCTION_USER_TIMEZONE=America/Santiago

# LibreLinkUp: unofficial API, no Abbott SDK exists. Use a FOLLOWER account
# (invited from the patient's own LibreLink app), never the patient's own login.
LIBRELINKUP_EMAIL=
LIBRELINKUP_PASSWORD=
LIBRELINKUP_REGION=la

# Catálogo de alimentos compartido (backend preparado, todavía no consumido
# por la app — ver docs/adr/0003-shared-food-catalog.md). Postgres de la
# instancia de Abacus. Ausente: /v1/food-catalog responde 503, el resto del
# backend sigue funcionando igual.
DATABASE_URL=
SHARED_CATALOG_MIN_TIMES_SEEN=3
